/*
 * mobile_dna.config - parameters of the Strongnose classification steps.
 *
 * Every value is a STARTING VALUE, set from one hg38 / ONT sample and tuned by hand; the ones marked "calibrate"
 * must be checked on new data (bin/summarize_events.pl prints what is needed).
 *
 * Names are flat on purpose, so any of them can be overridden on the command line: --ont_div_correction 1.5
 * Each parameter feeds one script as a GNU-style option with the same name written with dashes:
 *     polya_max_gap = 10   ->   find_polya.pl --polya-max-gap 10
 * The scripts do not read this file; Nextflow passes the values. The defaults inside the scripts are the same as below.
 * Profile-specific values (length ranges, TSD range, evidence, gates) are NOT here: they live in class_profiles.tsv.
 */

params {

    // ------------------------------------------------------------------ inputs (assets, versioned with the pipeline)
    subfamilies_tsv      = "${projectDir}/assets/subfamilies.tsv"      // repeat name -> group, age tier (annotate_hits.pl --subfamilies)
    class_profiles_tsv   = "${projectDir}/assets/class_profiles.tsv"   // one row per event profile (--profiles of annotate, merge, structure, classify)

    // ------------------------------------------------------------------ annotate_hits.pl: names and age
    // repeat names are normalised before the lookup in subfamilies.tsv
    name_case_insensitive = true                       // AluYa5 = aluya5
    name_strip_suffixes   = '_5,_5end,_3end'           // positional consensus fragments (Repbase-style names)
    name_int_equivalent   = true                       // "-int" and "I" suffixes are the same name (HERVK9-int = HERVK9I)

    // The "perc div" of the .out is reduced by ont_div_correction (percentage points, floor 0) and compared with the
    // ceiling of the tier. A hit is young for a profile when its tier is in the profile's young_tiers AND its
    // corrected divergence is below the ceiling.
    ont_div_correction   = 0.0                         // calibrate: summarize_events.pl section 5, peak of the active tier
    max_div_active       = 8.0                         // ceiling for tier "active" (AluYa5, AluYb8, L1HS, SVA_E/F...)   (calibrate)
    max_div_young        = 10.0                        // ceiling for tier "young"                                       (calibrate)
    max_div_generic      = 6.0                         // tier "generic" (plain Alu): the name gives no age, so stricter  (calibrate)

    // hit classes that are never promoted to elements by name, matched as prefixes of the RepeatMasker class
    artifact_classes     = 'Simple_repeat,Low_complexity,Satellite,Unknown'

    // ------------------------------------------------------------------ merge_hits.pl: fragments -> elements
    merge_use_rm_id        = true                      // the RepeatMasker ID column is the first joining pass
    merge_max_gap          = 100                       // bp on the insertion between two fragments of one element
    merge_cons_tolerance   = 20                        // bp of consensus order violation tolerated when joining by gap
    overlap_max_frac       = 0.20                      // a hit that overlaps accepted hits by more than this fraction is an alternative
    ignore_overlapped_hits = true                      // hits flagged "*" (overlapped by a higher-scoring hit) do not count
    min_primary_element_len = 100                      // bp; a shorter largest element is not primary (insertion dropped)

    // ------------------------------------------------------------------ find_polya.pl: poly-A tail
    polya_search_window  = 40                          // bp searched after the 3' end of the element
    polya_inside_margin  = 20                          // bp inside the element end where a tail may already start
    polya_max_gap        = 10                          // bp allowed between the element end and the start of the tail
    polya_min_len        = 10                          // minimum tail length (ONT: no exact run is required)
    polya_min_purity     = 0.85                        // minimum A fraction of the tail (T on the opposite strand)

    // ------------------------------------------------------------------ extract_flanks.pl and find_tsd.pl: TSD
    flank_size       = 80                              // bp of reference on each side of the insertion point; must cover tsd_scan_max + tsd_pos_window
    tsd_pos_window   = 2                               // the junction is also tried +-N bp (real TSDs sit at shift 0 or +-1; 2 keeps decoy hits low)
    tsd_scan_max     = 40                              // a run that reaches this length is flagged tsd_capped (duplication of the neighbouring sequence)
    tsd_min_len      = 4                               // below ~7 bp an exact TSD cannot reach tsd_max_pvalue, so this has no practical effect
    tsd_min_identity = 0.85                            // minimum identity of the two copies (ONT substitutions)
    tsd_max_pvalue   = 0.01                            // heuristic adjusted p-value, not calibrated; decoy false-positive rate 1.6% (49 of 3019)
    tsd_null_match   = 0.30                            // chance of a base match used by the p-value; too low inside GC-rich or low-complexity flanks
    anchor_base      = 'auto'                          // first insertion base is the VCF anchor: auto | yes | no
    tsd_decoy        = false                           // true = compare each insertion with the NEXT insertion's flank: false-positive rate (QC run)
    // TSD length range and identity for the verdict are set per profile in class_profiles.tsv

    // ------------------------------------------------------------------ check_ltr_structure.pl: provirus and solo LTR
    ltr_align_band   = 80                              // half width in bp of the banded alignment between the two LTRs
    // names, lengths, orientation and LTR identity are set per profile in class_profiles.tsv (rule_params)

    // ------------------------------------------------------------------ classify_events.pl
    artifact_max_tandem_frac    = 0.50                 // insertion dropped when Simple_repeat + Low_complexity cover more than this
    artifact_max_satellite_frac = 0.30                 // same for Satellite (centromeric calls are common on T2T)
    artifact_max_unknown_frac   = 0.50                 // same for Unknown
    polya_max_after_tail        = 50                   // a tail counts only when at most N bp follow it (TSD copy, short transduction)
    min_confidence       = 'low'                       // lowest level written to the events table: low | probable | high
    emit_discarded       = true                        // write discarded.tsv (classify_events.pl --discarded-out)

    // ------------------------------------------------------------------ select_review.pl: manual review list
    review_per_category  = 10                          // events sampled in each sampled category
    review_max_all       = 40                          // cap of the categories that list every event
    review_seed          = 1                           // same seed, same list
    review_window        = 150                         // bp on each side of the position in the IGV locus
}
