/*
 * mobile_dna.params.config - parameters of the mobile DNA classification step.
 * Every value is a STARTING VALUE (marked "calibrate" where it must be tuned on real data).
 * Names are flat on purpose, so any of them can be overridden from the command line: --ont_div_correction 1.5
 */

params {

    // ---------------------------------------------------------------- inputs
    subfamilies_tsv      = "${projectDir}/assets/subfamilies.tsv"
    class_profiles_tsv   = "${projectDir}/assets/class_profiles.tsv"

    // -------------------------------------------- repeat name normalization
    // applied to hit names before the lookup in subfamilies.tsv
    name_case_insensitive = true
    name_strip_suffixes   = '_5,_5end,_3end'                      // positional consensus fragments (Repbase-style names)
    name_int_equivalent   = true                                  // treat "-int" and "I" suffixes as the same name (HERVK9-int = HERVK9I)

    // ------------------------------------------------ age (divergence) filter
    // observed "perc div" in the .out is reduced by ont_div_correction (percentage points, floor 0) before use
    ont_div_correction   = 0.0                                    // calibrate: compare div of known-young hits with the expected ~1-3%
    max_div_active       = 8.0                                    // corrected div ceiling for tier "active"   (calibrate)
    max_div_young        = 10.0                                   // corrected div ceiling for tier "young"    (calibrate)
    max_div_generic      = 6.0                                    // tier "generic" (e.g. plain Alu): no name evidence, so stricter (calibrate)
    div_weighting        = 'length'                               // div of a merged element = length-weighted mean of its fragments
    min_primary_element_len = 100                                 // bp; shorter primary elements are not classified

    // --------------------------------------------------- merging of fragments
    merge_use_rm_id           = true                              // RepeatMasker "ID" column is the first joining pass
    merge_max_gap             = 100                               // bp on the query between fragments of one element
    overlap_max_frac          = 0.20                              // a hit overlapping accepted hits by more than this fraction of its length is an alternative
    ignore_overlapped_hits    = true                              // hits flagged "*" (overlapped by a higher-scoring hit) do not count toward coverage

    // --------------------------------------------------------- artifact filters
    artifact_classes            = 'Simple_repeat,Low_complexity,Satellite,Unknown'   // matched as class prefixes
    artifact_max_tandem_frac    = 0.50                            // max fraction of the insertion covered by Simple_repeat/Low_complexity
    artifact_max_satellite_frac = 0.30                            // max fraction covered by Satellite*; centromeric calls are common on T2T
    tandem_dup_check            = true                            // align the insertion to the reference flanks; drop insertions that duplicate neighbouring sequence
    tandem_dup_flank            = 1000                            // bp on each side of the breakpoint used for that comparison
    tandem_dup_min_identity     = 0.90

    // ---------------------------------------------------------------- poly-A
    polya_search_window  = 40                                     // bp searched past the 3' end of the element, up to the insertion end
    polya_min_len        = 10                                     // ONT homopolymer errors: no exact run is required
    polya_min_purity     = 0.85                                   // minimum A fraction (T on the opposite strand) in the tail

    // ------------------------------------------------------------------- TSD
    tsd_search_window    = 50                                     // bp each side of the Sniffles breakpoint; its position is imprecise
    // TSD length range and identity are set per profile in class_profiles.tsv

    // ---------------------------------------------------------------- output
    min_confidence       = 'low'                                  // lowest level written to the main table: low | probable | high
    emit_discarded       = true                                   // also write dropped insertions with the filter that removed them
}
